 "registers": [
  {
   "register": "ir",
   "holds": "the instruction",
   "written": "if IRWrite",
   "why": "the memory serves data later; the fields must stay"
  },
  {
   "register": "instr_pc",
   "holds": "its address",
   "written": "if IRWrite",
   "why": "the PC advances in the first step"
  },
  {
   "register": "rs1_q, rs2_q",
   "holds": "the register values",
   "written": "every cycle",
   "why": "the ALU uses them one step later"
  },
  {
   "register": "alu_q",
   "holds": "the ALU result",
   "written": "every cycle",
   "why": "the ALU does another job next"
  },
  {
   "register": "mdr",
   "holds": "the memory read data",
   "written": "every cycle",
   "why": "the register file is written a step later"
  }
 ],
 "signals": [
  {
   "signal": "PCWrite",
   "controls": "PC write",
   "values": "1: PC ← result"
  },
  {
   "signal": "Branch",
   "controls": "conditional PC write",
   "values": "1: PC written if BranchTaken"
  },
  {
   "signal": "IRWrite",
   "controls": "ir and instr_pc",
   "values": "1: ir ← memory, instr_pc ← PC"
  },
  {
   "signal": "AddrSel",
   "controls": "memory address",
   "values": "0: PC; 1: alu_q"
  },
  {
   "signal": "MemWrite",
   "controls": "memory write enable",
   "values": "1: M[addr] ← rs2_q"
  },
  {
   "signal": "RegWrite",
   "controls": "register-file write enable",
   "values": "1: R[rd] ← result"
  },
  {
   "signal": "ALUSrcA",
   "controls": "ALU operand a",
   "values": "00 PC, 01 instr_pc, 10 rs1_q"
  },
  {
   "signal": "ALUSrcB",
   "controls": "ALU operand b",
   "values": "00 rs2_q, 01 the constant 4, 10 imm"
  },
  {
   "signal": "ResultSel",
   "controls": "result multiplexer",
   "values": "00 alu_q, 01 mdr, 10 alu_y, 11 PC"
  }
 ],
