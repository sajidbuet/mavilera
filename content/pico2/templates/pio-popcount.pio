; Rights class: content (a MAVILERA template, written for the application).
;
; Build assembles this file; pio-popcount.c includes "pio-popcount.pio.h", which gives it the words as
; popcount_program[] and popcount_length, popcount_wrap_target and popcount_wrap.

.program popcount
    pull block              ; the word to count
    mov x, ~null            ; X = 0xffffffff
bit:
    out y, 1                ; the next bit into Y
    jmp !y skip             ; a 0: on to skip
    jmp x-- skip            ; a 1: X - 1 (either way on to skip)
skip:
    jmp !osre bit           ; bits left in the OSR? to bit
    mov isr, ~x             ; the count
    push block              ; to the RX FIFO; wrap to 0
