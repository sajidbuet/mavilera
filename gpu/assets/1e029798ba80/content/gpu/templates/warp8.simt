; warp8.simt -- SIMT core, eight lanes: one warp through an if/else, y = 6|x|
; Copyright (c) 2026 Sajid Muhaimin Choudhury. Licensed under the Apache License, Version 2.0.
; Rights class: content (Apache-2.0).
; (written for the application; choose the 8-lane profile; tick "Masks-only count" in the Masks view)
; compare, three instructions on the if-path, two on the else-path, one after
;
        .din  4, -1, -6, 3, 0, -2, 7, 5
        LDI   r3, 0           ; setup: r3 <- 0
        IFLT  r1, r3          ; compare x < 0: lanes 1, 2 and 5 stay active
        SUB   r2, r3, r1      ;   if-path 1: r2 <- -x
        ADD   r2, r2, r2      ;   if-path 2: r2 <- -2x
        SUB   r2, r2, r1      ;   if-path 3: r2 <- -3x
        ELSE                  ; lanes 0, 3, 4, 6 and 7
        ADD   r2, r1, r1      ;   else-path 1: r2 <- 2x
        ADD   r2, r2, r1      ;   else-path 2: r2 <- 3x
        ENDIF                 ; all eight lanes active again
        ADD   r2, r2, r2      ; after the if/else: r2 <- 2 r2
        HALT                  ; dout = 24, 6, 36, 18, 0, 12, 42, 30 after 11 cycles, 21 idle lane-slots
