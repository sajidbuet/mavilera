; nested.simt -- SIMT core, four lanes: one IFLT nested in another (the mask stack is two deep)
; Copyright (c) 2026 Sajid Muhaimin Choudhury. Licensed under the Apache License, Version 2.0.
; Rights class: content (Apache-2.0).
; (test 1 of the Chapter 11 laboratory's simt_tests.hex, written as source)
;
        .din  100, 200, 300, 400
        LDI   r3, 2           ; every lane: r3 <- 2
        IFLT  r0, r3          ; lanes 0 and 1 (lane index < 2)
        LDI   r2, 10          ;   r2 <- 10
        LDI   r3, 1           ;   r3 <- 1
        IFLT  r0, r3          ;   nested: lane 0 only
        ADD   r2, r2, r1      ;     r2 <- 10 + 100
        ENDIF                 ;   back to lanes 0 and 1
        ELSE                  ; lanes 2 and 3
        LDI   r2, 20          ;   r2 <- 20
        ENDIF                 ; all four lanes
        ADD   r2, r2, r0      ; r2 <- r2 + lane index
        HALT                  ; dout = 110, 11, 22, 23 after 12 cycles, 9 idle lane-slots
