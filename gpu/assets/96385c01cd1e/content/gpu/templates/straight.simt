; (test 2 of the Chapter 11 laboratory's simt_tests.hex, written as source)
;
        .din  1, -2, 3, -4
        ADD   r2, r1, r1      ; r2 <- 2 * din
        ADD   r2, r2, r0      ; r2 <- r2 + lane index
        HALT                  ; dout = 2, -3, 8, -5 after 3 cycles, 0 idle lane-slots
